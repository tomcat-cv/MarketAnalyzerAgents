# ── Required (at least one LLM backend) ──────────────────────────────
# Copy this file to .env and fill in the values before running.

# Zhipu GLM backend — https://open.bigmodel.cn
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-5.1
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ── Optional LLM backends ───────────────────────────────────────────

# OpenAI Responses API backend
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.4

# ── Optional data sources ───────────────────────────────────────────

# Identify automated requests to reliable sources such as SEC EDGAR.
RESEARCH_USER_AGENT=Your Name your-email@example.com

# Finnhub: adapter is implemented but disabled by default in config/sources.json.
# Set this key and enable collectors.finnhub to activate it.
# FINNHUB_API_KEY=your-finnhub-key

# Paid/delayed source adapters are reserved only and not called by default.
# LSEG_API_KEY=your-lseg-key
# NEWSAPI_KEY=your-newsapi-key
# NEWSDATA_API_KEY=your-newsdata-key

# ── Optional scheduler overrides ────────────────────────────────────
# These take priority over config/settings.json.

# MARKET_ANALYZER_AGENTS_SCHEDULE_MODE=daily
# MARKET_ANALYZER_AGENTS_SCHEDULE_TIME=06:00
# MARKET_ANALYZER_AGENTS_INTERVAL_MINUTES=1440
# MARKET_ANALYZER_AGENTS_RUN_ON_START=false

# ── Optional Feishu delivery ────────────────────────────────────────
# When set, conversation outbox events are also sent to the Feishu bot.
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-id
# MARKET_ANALYZER_AGENTS_BRIEF_BASE_URL=http://127.0.0.1:8000
