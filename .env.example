# Copy to .env and fill values before running the Zhipu backend.
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-5.1
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# Identify automated requests to reliable sources such as SEC EDGAR.
RESEARCH_USER_AGENT=Your Name your-email@example.com

# Optional: the Finnhub adapter is implemented but disabled by default in config/sources.json.
# Set this key and enable collectors.finnhub when you want to activate it.
# FINNHUB_API_KEY=your-finnhub-key

# Paid/delayed source adapters are reserved only and are not called by default.
# LSEG_API_KEY=your-lseg-key
# NEWSAPI_KEY=your-newsapi-key
# NEWSDATA_API_KEY=your-newsdata-key

# Optional fallback if you still want to use the OpenAI backend.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.4

# Optional: if you want output written straight into an Obsidian vault.
# OBSIDIAN_VAULT_PATH=/Users/you/Documents/Obsidian/Vault
