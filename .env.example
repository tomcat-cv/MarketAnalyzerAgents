# ── Required (at least one LLM backend) ──────────────────────────────
# Copy this file to .env and fill in the values before running.

# Zhipu GLM backend — https://open.bigmodel.cn
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-5.1
ZHIPU_API_BASE=https://open.bigmodel.cn/api/paas/v4

# ── Optional LLM backends ───────────────────────────────────────────

# OpenAI Responses API backend
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_MODEL=gpt-5.4

# ── Optional data sources ───────────────────────────────────────────

# Identify automated requests to configured RSS and market-data sources.
MARKET_ANALYZER_AGENTS_USER_AGENT=Your Name your-email@example.com

# ── Optional scheduler overrides ────────────────────────────────────
# These take priority over config/settings.json.

# MARKET_ANALYZER_AGENTS_REPORT_SCHEDULE=08:00,14:00,20:00
# MARKET_ANALYZER_AGENTS_INTRADAY_INTERVAL_SECONDS=1800
